{
  "kind": "collectionType",
  "collectionName": "module_contents",
  "info": {
    "singularName": "module-content",
    "pluralName": "module-contents",
    "displayName": "Module Content",
    "description": "Linking collection for module content with position"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "position": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "module": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::module.module",
      "inversedBy": "module_contents"
    },
    "paragraph": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::paragraph.paragraph",
      "inversedBy": "module_contents"
    },
    "table": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::table.table",
      "inversedBy": "module_contents"
    },
    "image": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::image.image",
      "inversedBy": "module_contents"
    },
    "mcq": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::mcq.mcq",
      "inversedBy": "module_contents"
    },
    "contentType": {
      "type": "enumeration",
      "enum": ["paragraph", "table", "image", "mcq"],
      "required": true
    },
    "publishedAt": {
      "type": "datetime"
    }
  }
}

{
  "kind": "collectionType",
  "collectionName": "images",
  "info": {
    "singularName": "image",
    "pluralName": "images",
    "displayName": "Image",
    "description": "Image content with caption and alt text"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "file": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "caption": {
      "type": "string"
    },
    "altText": {
      "type": "string",
      "required": true
    },
    "module_contents": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::module-content.module-content",
      "mappedBy": "image"
    },
    "publishedAt": {
      "type": "datetime"
    }
  }
}
